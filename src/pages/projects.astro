---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/cards/ProjectCard.astro';
import ProjectResearchCard from '../components/cards/ProjectResearchCard.astro';
import SectionLabel from '../components/ui/SectionLabel.astro';
import { object } from 'astro:schema';
---

<BaseLayout title="Projects - Quant Research">
  <h1 class="font-serif text-4xl font-semibold text-slate-900">
    Index of Projects
  </h1>

  <p class="mt-4 max-w-2xl text-sm leading-7 text-slate-600">
    Categorized compilation of technical implementations, experiments, and projects infrastructure.
  </p>

  <section class="mt-10 grid gap-4">
    <SectionLabel text="Research Projects" class='mb-3'/>
    <ProjectCard
      title="Supervised Classification Models for Predictive Maintenance and System Failure"
      objective="Use machine operating data from the AI4I 2020 Predictive Maintenance Dataset to predict machine failures, compare classification models, and account for the low frequency of failure events."
      implementation="Explored and prepared 10,000 machine records, feature engineering and preventing data leakage by excluding identifiers and failure-mechanism indicators from the predictors. Trained and compared nine baseline and advanced classifiers using stratified five-fold cross-validation, then evaluated them on a held-out test set. Used SHAP to interpret the Gradient Boosting model."      
      outcome="Produced an end-to-end classification and evaluation workflow with model comparisons, test-set metrics, classification reports, and feature explanations. On the test set, Gradient Boosting achieved the highest F1 score (0.8889), HistGradientBoosting achieved the highest Average Precision (0.9057), and Decision Tree achieved the highest recall (0.9118)."
      stack={[
        'Python',
        'scikit-learn',
        'Feature Engineering',
        'Stratified 5-Fold Cross-Validation',
        'Ensemble Learning (Random Forest & Gradient Boosting)',
        'Multilayer Perceptron (Neural Network)',
        'Class-Imbalance Evaluation (Precision, Recall & Average Precision)',
        'SHAP Explainability',
        'Game Theory',
      ]}
      sourceUrl="https://github.com/w0lfpy"
    />

    <ProjectCard
      title="Applied ML for Home Credit Default Risk - Kaggle Competition"
      objective="Predict whether a loan applicant will experience payment difficulties using Home Credit application data and historical credit and payment records, while accounting for the low frequency of positive cases.",
      implementation="Explored and prepared the application data, engineered applicant-level features from historical tables, and built baseline and advanced classification workflows. Compared and tuned classifiers using validation data and stratified five-fold cross-validation, addressing class imbalance by undersampling the training set. Selected the final model using ROC-AUC, evaluated it on a held-out test set, analyzed decision thresholds, and used SHAP to interpret feature contributions.",
      outcome="Produced an end-to-end workflow for data exploration, feature preparation, model comparison, and evaluation. The selected Gradient Boosting model achieved a validation ROC-AUC of 0.7783 and a held-out test ROC-AUC of 0.7818. At a 0.50 threshold, positive-class recall was 0.7143 and at a threshold near 0.41, recall increased to 0.8096.",
      stack={[
        "Python",
        "pandas & NumPy",
        "scikit-learn",
        "Feature Engineering and Historical Data Aggregation",
        "Stratified Train/Validation/Test Splits",
        "Stratified 5-Fold Cross-Validation",
        "Ensemble Learning (Gradient Boosting and Tree-Based Models)",
        "Class-Imbalance Handling",
        "ROC-AUC, PR-AUC, Precision, Recall & F1",
        "Threshold Analysis & Optimization",
        "SHAP Explainability",
      ]},
      sourceUrl="https://github.com/w0lfpy/Home-Credit-Default-Risk"
      whitePaperUrl="/papers/credit_default_risk_report.pdf"
    />
  </section>

  <section class="mt-10 grid gap-4">
    <SectionLabel text="University Projects" class='mb-3'/>
    <ProjectCard
      title="Madrid Subway Network Optimization via Graph Theory"
      objective="Represent the Madrid Metro system as a mathematical graph to study urban transit connectivity and compute optimal routes between stations through weighted shortest-path search."
      implementation="Constructed a graph from structured station data, modelling each station as a vertex and each direct connection as a weighted edge. Edge weights were derived from Euclidean distance over station coordinates, while route optimization was performed using Dijkstra’s algorithm. The system was exposed through a Streamlit web interface with interactive route visualization."      
      outcome="Produced an end-to-end route optimization tool that allows users to query stations, analyse neighbouring connections, compute shortest paths, estimate total route distance, and visualize the resulting journey over an interactive map."
      stack={[
        'Python',
        'Streamlit',
        'Pandas',
        'Dijkstra Algorithm',
        'Graph Theory',
        'streamlit-folium',
        'CSV Data Processing',
      ]}
      sourceUrl="https://github.com/w0lfpy/MadridSubway"
    />
    <ProjectCard
      title="Real-Time Sign Language Recognition via Hand Landmark Analysis"
      objective="Design a vision-based recognition system for sign-language alphabet gestures, transforming webcam hand-motion input into structured letter predictions and live text transcription."
      implementation="Implemented a Python computer vision pipeline using OpenCV and MediaPipe Hands. The system extracts 21 hand landmarks per frame and evaluates the relative spatial configuration of the fingers to determine whether each finger is extended or folded. These geometric patterns are mapped to predefined alphabet gestures and rendered as recognized letters in real time."
      outcome="Produced a functional real-time prototype for sign-language alphabet recognition, capable of detecting hand landmarks, classifying gesture states, displaying diagnostic information, and building a live transcription from the recognized letters. The architecture provides a foundation for future extensions into word-level recognition and sequence modelling."
      stack={[
        'Python',
        'OpenCV',
        'MediaPipe',
        'NumPy',
        'Pandas',
        'Webcam Video Processing',
        'Hand Landmark Geometry',
        'Gesture-to-Letter Mapping',
      ]}
      sourceUrl="https://github.com/w0lfpy/SingLeng"
    />
    <ProjectCard
      title="Commercy — Full-Stack Commerce Management System"
      objective="Develop a full-stack management platform for small businesses, enabling administrators and users to create, organize, evaluate, and discover commercial websites through structured business data, reviews, ratings, and search filters."
      implementation="Implemented a Node.js and Express REST API backed by MongoDB, with data models for users, businesses, and websites. The backend includes role-based authentication, commerce CRUD operations, website content management, image and text uploads, review and scoring functionality, city and interest-based filtering, Swagger documentation, and a testing workflow. A Next.js frontend was built as the client layer for consuming the API and interacting with the platform."
      outcome="Produced an end-to-end web platform with a clear separation between API and frontend, persistent MongoDB storage, authenticated user flows, business and website management capabilities, documented REST endpoints, upload handling, and a foundation for extending the system into a production-oriented local commerce directory."
      stack={[
        'Node.js',
        'Express',
        'MongoDB',
        'Mongoose',
        'JWT',
        'Next.js',
        'Swagger',
        'RESTful API',
        'Role-Based Access Control',
        'File Upload System',
      ]}
      sourceUrl="https://github.com/w0lfpy/Commercy"
    />
    <ProjectCard
      title="Autonomous Multi-Agent Robotics Simulation in Webots"
      objective="Design and implement a competitive multi-agent robotics environment that models pursuit-evasion behavior between a hunter robot and multiple runner robots, using autonomous control, sensor-based navigation, and real-time game-state supervision."
      implementation="Built the system in Webots with Python-based controllers for the hunter, runner agents, and simulation supervisor. Each robot uses a differential-drive configuration with wheel encoders for odometry, GPS and compass fallback for pose estimation, infrared sensors for obstacle avoidance, and wireless channels for inter-agent communication. Robot behavior is governed by finite state machines covering search, chase, wander, avoidance, recovery, and capture-related states."
      outcome="Produced a fully functional robotics simulation with autonomous pursuit-evasion dynamics, distance-based capture detection, real-time position broadcasting, timer and bonus management, obstacle avoidance, recovery from stuck states, and configurable parameters for gameplay balance and controller tuning."
      stack={[
        'Python',
        'Webots',
        'Webots Python API',
        'Finite State Machines',
        'Differential Odometry',
        'Sensor Fusion',
        'Infrared Obstacle Avoidance',
        'Wireless Communication',
        'Supervisor Controller',
        'Multi-Agent Robotics',
      ]}
      sourceUrl="https://github.com/w0lfpy/robotics-final"
    />
  </section>
</BaseLayout>
